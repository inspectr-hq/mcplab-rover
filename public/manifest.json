{
  "manifest_version": 3,
  "name": "MCPLab Rover",
  "version": "0.1.1",
  "description": "Run a prompt in the active chat tab and capture the completed response.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "web_accessible_resources": [{
    "resources": ["rover.html", "rover.js", "assets/*", "icons/*"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_title": "Toggle MCPLab Rover",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
